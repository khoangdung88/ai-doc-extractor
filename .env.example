# Copy to .env and fill in. Never commit .env.
DOCEXT_ENV=dev
DOCEXT_LOG_LEVEL=INFO

# Default provider/model used when the request does not specify one.
# Format: <provider>:<model>, e.g. openai:gpt-4o-mini, anthropic:claude-3-5-sonnet-latest, gemini:gemini-1.5-flash, mock:echo
DOCEXT_DEFAULT_MODEL=mock:echo

# Provider credentials (only the ones you use)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
